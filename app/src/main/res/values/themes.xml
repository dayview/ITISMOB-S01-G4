<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Purrfolio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purr_primary</item>
        <item name="colorOnPrimary">@color/purr_on_primary</item>
        <item name="android:windowBackground">@color/purr_bg</item>
    </style>
    <style name="Purr.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/purr_text</item>
    </style>
    <style name="Purr.Sub">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/purr_subtle</item>
    </style>
    <style name="Purr.Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/purr_text</item>
        <item name="android:textColorHint">@color/purr_subtle</item>
    </style>
    <style name="Purr.Field.Banner">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Purr.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Purr.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>