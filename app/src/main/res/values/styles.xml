<resources>
<style name="PurrfolioWelcomeButton">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">@dimen/button_height</item>
    <item name="android:gravity">center</item>
    <item name="android:fontFamily">@font/nunito</item>
    <item name="android:textSize">17sp</item>
    <item name="android:textColor">@color/welcome_button_text</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
</style>
<style name="PurrfolioDockCell">
    <item name="android:layout_width">0dp</item><item name="android:layout_height">66dp</item>
    <item name="android:layout_weight">1</item><item name="android:layout_marginStart">4dp</item>
    <item name="android:layout_marginEnd">4dp</item><item name="android:orientation">vertical</item>
    <item name="android:gravity">center</item><item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
</style>
<style name="PurrfolioDockLabel">
    <item name="android:layout_width">match_parent</item><item name="android:layout_height">21dp</item>
    <item name="android:fontFamily">@font/nunito</item><item name="android:textSize">11sp</item>
    <item name="android:textColor">@color/screen_subtext</item><item name="android:gravity">center</item>
    <item name="android:includeFontPadding">false</item><item name="android:lineSpacingExtra">2dp</item>
</style>
<style name="LegacyBodyText">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:fontFamily">@font/nunito</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:includeFontPadding">true</item>
</style>
<style name="LegacyNavCell">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">56dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:orientation">vertical</item>
    <item name="android:gravity">center</item>
    <item name="android:paddingStart">2dp</item>
    <item name="android:paddingTop">3dp</item>
    <item name="android:paddingEnd">2dp</item>
    <item name="android:paddingBottom">3dp</item>
</style>
</resources>
