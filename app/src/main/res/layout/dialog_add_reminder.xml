<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="22dp"
    android:paddingTop="12dp" android:paddingEnd="22dp"
    android:paddingBottom="8dp">
    <EditText android:id="@+id/reminderTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Task: vaccination, medication, feeding..."
        android:inputType="textCapSentences" android:singleLine="true"
        android:textSize="15sp" />
    <EditText android:id="@+id/reminderWhen" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Date and time (e.g. Nov 3, 9:00 AM)"
        android:inputType="text" android:singleLine="true"
        android:textSize="15sp" />
</LinearLayout>
