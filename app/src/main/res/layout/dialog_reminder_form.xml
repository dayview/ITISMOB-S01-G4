<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp"
    android:paddingBottom="8dp">

    <Spinner
        android:id="@+id/reminderPetSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/reminderTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Task: vaccination, medication, feeding..."
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/reminderDetailInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Details (e.g. 1/2 cup kibble, 1 tablet)"
        android:inputType="text"
        android:singleLine="true"
        android:textSize="15sp" />

    <Spinner
        android:id="@+id/reminderCategorySpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/reminderDateButton"
        style="@style/LegacyBodyText"
        android:layout_marginTop="8dp"
        android:background="@drawable/legacy_input"
        android:padding="14dp"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/reminderTimeButton"
        style="@style/LegacyBodyText"
        android:layout_marginTop="8dp"
        android:background="@drawable/legacy_input"
        android:padding="14dp"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/reminderRepeatCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Repeat every day"
        android:textSize="15sp" />

</LinearLayout>