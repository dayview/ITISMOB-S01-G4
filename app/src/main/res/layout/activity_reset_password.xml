<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/Purr.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/resetTitleTv"
        android:text="Reset Password" />

    <TextView
        style="@style/Purr.Sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/resetSubtitleTv"
        android:text="We'll send you a link to reset it." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:id="@+id/resetEmojiTv"
        android:text="✉️"
        android:textSize="64sp" />

    <EditText
        android:id="@+id/emailEt"
        style="@style/Purr.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Email Address"
        android:inputType="textEmailaddress" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sendBtn"
        style="@style/Purr.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Send Reset Link" />

    <TextView
        style="@style/Purr.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:id="@+id/resetTipsTitleTv"
        android:text="Didn't receive the email?"
        android:textsize="18sp" />

    <TextView
        style="@style/Purr.Sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:id="@+id/resetTipsTv"
        android:lineSpacingExtra="6dp"
        android:text="✓ Check your spam folder\n ✓Make sure you entered the correct email\n ✓Try again in a few minutes" />

</LinearLayout>
