<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        style="@style/Purr.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/logTitleTv"
        android:text="Log Care" />

    <TextView
        android:id="@+id/subtitleTv"
        style="@style/Purr.Sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feedingBtn"
            style="@style/Purr.TonalButton"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Feeding"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/medicationBtn"
            style="@style/Purr.TonalButton"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Medication"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/waterBtn"
            style="@style/Purr.TonalButton"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Water"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playtimeBtn"
            style="@style/Purr.TonalButton"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Playtime"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vetBtn"
            style="@style/Purr.TonalButton"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Vet Visit"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groomingBtn"
            style="@style/Purr.TonalButton"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Grooming"
            android:textSize="12sp" />
    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/voiceBtn"
        style="@style/Purr.Button"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="12dp"
        android:text="🎤 Log with Voice\nJust say what happened" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/soundBtn"
        style="@style/Purr.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sound Event Journal" />

</LinearLayout>
