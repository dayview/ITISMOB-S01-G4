<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/remindersRoot"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <include android:id="@+id/header"
        layout="@layout/legacy_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/remindersEyebrow"
                style="@style/LegacyBodyText"
                android:letterSpacing="0.18"
                android:text="PROACTIVE CARE"
                android:textColor="@color/primary"
                android:textSize="22sp" />

            <Space android:layout_width="1dp" android:layout_height="10dp" />

            <TextView
                android:id="@+id/reminderTitle"
                style="@style/LegacyBodyText"
                android:fontFamily="@font/fredoka"
                android:text="Reminders"
                android:textSize="30sp" />

            <Space android:layout_width="1dp" android:layout_height="5dp" />

            <TextView
                android:id="@+id/remindersSubtitle"
                style="@style/LegacyBodyText"
                android:text="never miss a moment of their care"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Space android:layout_width="1dp" android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/legacy_chip"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:text="All"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/filterMedication"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/legacy_chip"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:text="Medication"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/filterFeeding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/legacy_chip"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:text="Feeding"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/filterOthers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/legacy_chip"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:text="Others"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="12dp" />

            <LinearLayout
                android:id="@+id/reminderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/newReminderButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/legacy_button"
                android:gravity="center"
                android:text="+ New Reminder"
                android:textColor="@color/on_primary"
                android:textSize="15sp" />
        </LinearLayout>

    </ScrollView>

    <include android:id="@+id/bottomNav"
        layout="@layout/floating_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="5dp" />

</LinearLayout>