<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/welcome_horizontal_padding"
            android:paddingEnd="@dimen/welcome_horizontal_padding"
            android:paddingBottom="12dp">

            <Space android:layout_width="1dp" android:layout_height="90dp" />

            <ImageView
                android:id="@+id/welcomeLogo"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:contentDescription="PURRFOLIO"
                android:scaleType="fitCenter"
                android:src="@drawable/purrfolio_wordmark_alpha" />

            <TextView
                android:id="@+id/welcomeTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="their care, their story."
                android:textColor="@color/welcome_primary"
                android:textSize="21sp" />

            <Space android:layout_width="1dp" android:layout_height="30dp" />

            <ImageView
                android:id="@+id/welcomeCat"
                android:layout_width="match_parent"
                android:layout_height="265dp"
                android:contentDescription="Fluffy cream cat with pink heart"
                android:scaleType="fitCenter"
                android:src="@drawable/purrfolio_cat_hero" />

            <Space android:layout_width="1dp" android:layout_height="5dp" />

            <TextView
                android:id="@+id/getStartedButton"
                style="@style/PurrfolioWelcomeButton"
                android:layout_height="54dp"
                android:layout_marginBottom="9dp"
                android:background="@drawable/button_welcome_primary"
                android:text="Get Started" />

            <TextView
                android:id="@+id/logInButton"
                style="@style/PurrfolioWelcomeButton"
                android:layout_marginBottom="10dp"
                android:background="@drawable/button_welcome_secondary"
                android:text="Log In"
                android:textColor="@color/welcome_primary" />

            <TextView
                android:id="@+id/continueWithLabel"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Continue with"
                android:textColor="@color/welcome_subtext"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/googleButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/social_container"
                    android:contentDescription="Continue with Google">
                    <com.purrfolio.mco1.CareArtwork
                        android:layout_width="29dp" android:layout_height="29dp"
                        android:layout_gravity="center" app:artKind="Google" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/appleButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/social_container"
                    android:contentDescription="Continue with Apple">
                    <com.purrfolio.mco1.CareArtwork
                        android:layout_width="29dp" android:layout_height="29dp"
                        android:layout_gravity="center" app:artKind="Apple"
                        app:artTint="@color/text_primary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/facebookButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/social_container"
                    android:contentDescription="Continue with Facebook">
                    <com.purrfolio.mco1.CareArtwork
                        android:layout_width="29dp" android:layout_height="29dp"
                        android:layout_gravity="center" app:artKind="Facebook" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:orientation="horizontal">
                <View android:layout_width="9dp" android:layout_height="9dp"
                    android:layout_marginHorizontal="7dp" android:background="@drawable/welcome_dot_active" />
                <View android:layout_width="9dp" android:layout_height="9dp"
                    android:layout_marginHorizontal="7dp" android:background="@drawable/welcome_dot_inactive" />
                <View android:layout_width="9dp" android:layout_height="9dp"
                    android:layout_marginHorizontal="7dp" android:background="@drawable/welcome_dot_inactive" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
