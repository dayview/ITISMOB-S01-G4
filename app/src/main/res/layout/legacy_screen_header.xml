<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="22dp" android:paddingTop="12dp"
    android:paddingEnd="22dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/backButton" style="@style/LegacyBodyText"
        android:layout_width="44dp" android:layout_height="42dp"
        android:contentDescription="Back" android:fontFamily="@font/fredoka"
        android:gravity="center" android:text="‹" android:textColor="@color/primary"
        android:textSize="34sp" />
    <TextView android:id="@+id/screenTitle" style="@style/LegacyBodyText"
        android:layout_width="0dp" android:layout_height="42dp"
        android:layout_weight="1" android:ellipsize="end"
        android:fontFamily="@font/fredoka" android:gravity="center_vertical"
        android:maxLines="1" android:textColor="@color/primary" android:textSize="19sp" />
    <TextView android:id="@+id/petChooser" style="@style/LegacyBodyText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/legacy_chip" android:paddingStart="10dp"
        android:paddingTop="9dp" android:paddingEnd="10dp" android:paddingBottom="9dp"
        android:gravity="center_vertical" android:textColor="@color/text_primary" android:textSize="12sp" />
</LinearLayout>
