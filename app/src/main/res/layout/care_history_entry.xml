<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/legacy_card"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="17dp" android:paddingTop="16dp"
    android:paddingEnd="17dp" android:paddingBottom="17dp">
    <TextView android:id="@+id/entryIcon" style="@style/LegacyBodyText"
        android:layout_width="38dp" android:fontFamily="@font/fredoka"
        android:text="✎" android:textColor="@color/primary" android:textSize="23sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/entryTitle" style="@style/LegacyBodyText"
            android:textSize="17sp" />
        <TextView android:id="@+id/entryDescription" style="@style/LegacyBodyText"
            android:textColor="@color/text_secondary" android:textSize="13sp" />
    </LinearLayout>
    <TextView style="@style/LegacyBodyText" android:layout_width="wrap_content"
        android:text="›" android:textColor="@color/primary" android:textSize="27sp" />
</LinearLayout>
