<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/themeRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/welcome_background" android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="8dp"
            android:paddingEnd="20dp" android:paddingBottom="12dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="68dp"
                android:layout_marginBottom="10dp">
                <FrameLayout android:id="@+id/themeBack" android:layout_width="40dp"
                    android:layout_height="40dp" android:contentDescription="Back">
                    <com.purrfolio.mco1.CareArtwork android:layout_width="26dp"
                        android:layout_height="26dp" android:layout_gravity="center"
                        app:artKind="Back" app:artTint="@color/screen_primary" />
                </FrameLayout>
                <TextView android:id="@+id/themeHeading" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="16dp"
                    android:fontFamily="@font/fredoka" android:gravity="center"
                    android:includeFontPadding="false" android:lineSpacingExtra="2dp"
                    android:text="App Theme" android:textColor="@color/screen_primary"
                    android:textSize="30sp" />
            </FrameLayout>

            <TextView android:id="@+id/themeSubtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="20dp"
                android:fontFamily="@font/nunito" android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="Choose how PURRFOLIO looks on this device."
                android:textColor="@color/screen_subtext" android:textSize="14sp" />

            <include android:id="@+id/lightOption" layout="@layout/theme_option"
                android:layout_width="match_parent" android:layout_height="80dp"
                android:layout_marginBottom="10dp" />
            <include android:id="@+id/darkOption" layout="@layout/theme_option"
                android:layout_width="match_parent" android:layout_height="80dp"
                android:layout_marginBottom="10dp" />
            <include android:id="@+id/systemOption" layout="@layout/theme_option"
                android:layout_width="match_parent" android:layout_height="80dp"
                android:layout_marginBottom="10dp" />
        </LinearLayout>
    </ScrollView>

    <include android:id="@+id/bottomNav" layout="@layout/floating_bottom_nav"
        android:layout_width="match_parent" android:layout_height="78dp"
        android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
        android:layout_marginBottom="5dp" />
</LinearLayout>
