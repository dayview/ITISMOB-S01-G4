<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/theme_option_normal"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/optionTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="@font/nunito"
            android:includeFontPadding="false" android:lineSpacingExtra="2dp"
            android:textColor="@color/screen_text" android:textSize="16sp" />
        <TextView android:id="@+id/optionDescription" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:fontFamily="@font/nunito" android:includeFontPadding="false"
            android:lineSpacingExtra="2dp" android:textColor="@color/screen_subtext"
            android:textSize="12sp" />
    </LinearLayout>

    <RadioButton android:id="@+id/optionRadio" android:layout_width="48dp"
        android:layout_height="48dp" android:buttonTint="@color/screen_primary"
        android:clickable="false" android:focusable="false"
        android:importantForAccessibility="no" android:saveEnabled="false" />
</LinearLayout>
