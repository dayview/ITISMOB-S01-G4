<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <include
        android:id="@+id/header"
        layout="@layout/legacy_screen_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/calendarEyebrow"
                style="@style/LegacyBodyText"
                android:letterSpacing="0.18"
                android:text="PET CARE CALENDAR"
                android:textColor="@color/primary"
                android:textSize="11sp" />

            <Space android:layout_width="1dp" android:layout_height="10dp" />

            <TextView
                android:id="@+id/calendarTitle"
                style="@style/LegacyBodyText"
                android:fontFamily="@font/fredoka"
                android:text="Care calendar"
                android:textSize="30sp" />

            <Space android:layout_width="1dp" android:layout_height="5dp" />

            <TextView
                android:id="@+id/calendarSubtitle"
                style="@style/LegacyBodyText"
                android:text="tap a day, then tap an item to add it to your phone's calendar"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Space android:layout_width="1dp" android:layout_height="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/monthPrev"
                    style="@style/LegacyBodyText"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:contentDescription="Previous month"
                    android:gravity="center"
                    android:text="<"
                    android:textColor="@color/primary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/monthLabel"
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/monthNext"
                    style="@style/LegacyBodyText"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:contentDescription="Next month"
                    android:gravity="center"
                    android:text=">"
                    android:textColor="@color/primary"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sun"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Mon"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tue"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Wed"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Thu"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Fri"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    style="@style/LegacyBodyText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sat"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <GridLayout
                android:id="@+id/calendarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:columnCount="7" />

            <Space android:layout_width="1dp" android:layout_height="14dp" />

            <TextView
                android:id="@+id/selectedDayLabel"
                style="@style/LegacyBodyText"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/dayContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/addToCalendarButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/legacy_button"
                android:gravity="center"
                android:text="Add to phone calendar"
                android:textColor="@color/on_primary"
                android:textSize="15sp" />
        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/floating_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="5dp" />

</LinearLayout>