<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/documentCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/legacy_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="17dp"
    android:paddingTop="16dp"
    android:paddingEnd="17dp"
    android:paddingBottom="17dp">

    <TextView
        android:id="@+id/documentIcon"
        style="@style/LegacyBodyText"
        android:layout_width="38dp"
        android:fontFamily="@font/fredoka"
        android:text="▤"
        android:textColor="@color/primary"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/documentTitle"
            style="@style/LegacyBodyText"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/documentMeta"
            style="@style/LegacyBodyText"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Empty slot. DocumentsScreen draws the same chevron icon the Pet Timeline uses. -->
    <FrameLayout
        android:id="@+id/documentChevron"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no" />

</LinearLayout>