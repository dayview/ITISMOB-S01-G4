rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function valid(d, id) {
      return d.keys().hasAll(['id','petId','petName','kind','text','source','amount','transcript',
        'occurredAt','durationMs','audioDeviceId','status','revision','createdAt','updatedAt'])
        && d.keys().hasOnly(['id','petId','petName','kind','text','source','amount','transcript',
        'occurredAt','durationMs','audioDeviceId','status','revision','createdAt','updatedAt'])
        && d.id == id && id.matches('[A-Za-z0-9_-]{1,128}')
        && d.petId is string && d.petId.matches('[A-Za-z0-9_-]{1,128}')
        && d.petName is string && d.petName.size() > 0 && d.petName.size() <= 120 && d.petName.matches('(?s).*\\S.*')
        && d.kind in ['Feeding','Medication','Vitamins','Water','Playtime','Grooming','Vet Visit','Other','Observation']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 4000 && d.text.matches('(?s).*\\S.*')
        && d.amount is string && d.amount.size() <= 120
        && d.transcript is string && d.transcript.size() <= 4000
        && d.occurredAt is int && d.occurredAt > 0 && d.occurredAt <= request.time.toMillis() + 86400000
        && d.durationMs is int && d.revision is int && d.revision > 0
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.status in ['ready','deleting']
        && d.source in ['text','voice','audio']
        && (d.source != 'voice' || (d.transcript.size() > 0 &&
            (!(d.kind in ['Feeding','Medication','Vitamins','Water']) || d.amount.matches('(?s).*\\S.*'))))
        && ((d.source == 'audio' && d.kind == 'Observation' && d.durationMs >= 1000 && d.durationMs <= 60000
            && d.audioDeviceId is string && d.audioDeviceId.matches('[A-Za-z0-9_-]{1,128}'))
          || (d.source != 'audio' && d.durationMs == 0 && d.audioDeviceId == ''));
    }
    // Existing live User Management rule, preserved verbatim on 2026-11-07.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/careLogs/{id} {
      allow get, list: if owner(uid);
      allow create: if owner(uid) && valid(request.resource.data,id)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.status == 'ready';
      allow update: if owner(uid) && valid(request.resource.data,id)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['kind','text','amount','occurredAt','status','revision','updatedAt'])
        && ((resource.data.status == 'ready' && request.resource.data.status == 'ready')
          || (resource.data.status == 'ready' && request.resource.data.status == 'deleting'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedAt'])));
      allow delete: if owner(uid) && resource.data.status == 'deleting';
    }
    // Document importance
    match /users/{uid} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /pets/{petId} {
      function isMember() {
        return request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pets/$(petId)).data.members;
      }
      function isMemberAfter() {
        return request.auth != null &&
          request.auth.uid in getAfter(/databases/$(database)/documents/pets/$(petId)).data.members;
      }
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /{sub}/{doc} {
        allow read: if isMember();
        allow write: if isMemberAfter();
      }
    }
    // Add this match block inside the existing Firestore
    // service cloud.firestore { match /databases/{database}/documents { ... } }.
    // Keep all existing rules; do not replace the live ruleset with this fragment.
    match /sitterLinks/{token} {
      function isSitterOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
      function validPet() {
        return request.resource.data.pet is map
          && request.resource.data.pet.keys().hasAll([
            'name', 'species', 'breed', 'notes', 'medicalInfo', 'vetClinic',
            'vetPhone', 'emergencyContactName', 'emergencyContactPhone'])
          && request.resource.data.pet.keys().hasOnly([
            'name', 'species', 'breed', 'notes', 'medicalInfo', 'vetClinic',
            'vetPhone', 'emergencyContactName', 'emergencyContactPhone'])
          && request.resource.data.pet.name is string
          && request.resource.data.pet.name.size() <= 500
          && request.resource.data.pet.species is string
          && request.resource.data.pet.species.size() <= 500
          && request.resource.data.pet.breed is string
          && request.resource.data.pet.breed.size() <= 500
          && request.resource.data.pet.notes is string
          && request.resource.data.pet.notes.size() <= 500
          && request.resource.data.pet.medicalInfo is string
          && request.resource.data.pet.medicalInfo.size() <= 500
          && request.resource.data.pet.vetClinic is string
          && request.resource.data.pet.vetClinic.size() <= 500
          && request.resource.data.pet.vetPhone is string
          && request.resource.data.pet.vetPhone.size() <= 500
          && request.resource.data.pet.emergencyContactName is string
          && request.resource.data.pet.emergencyContactName.size() <= 500
          && request.resource.data.pet.emergencyContactPhone is string
          && request.resource.data.pet.emergencyContactPhone.size() <= 500;
      }
      function validWrite() {
        return request.resource.data.keys().hasAll([
            'ownerUid', 'petId', 'active', 'createdAt', 'expiresAt', 'pet'])
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'petId', 'active', 'createdAt', 'expiresAt', 'pet'])
          && request.resource.data.ownerUid is string
          && request.resource.data.petId is string
          && request.resource.data.petId.size() > 0
          && request.resource.data.petId.size() <= 128
          && request.resource.data.active is bool
          && request.resource.data.createdAt is int
          && request.resource.data.expiresAt is int
          && validPet();
      }
      // The token is 32 random bytes in URL-safe base64. No public listing.
      allow get: if isSitterOwner() ||
        (resource.data.active == true && resource.data.expiresAt > request.time.toMillis());
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && token.matches('^[A-Za-z0-9_-]{43}$')
        && validWrite()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.createdAt <= request.time.toMillis() + 60000
        && request.resource.data.createdAt >= request.time.toMillis() - 60000
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 604860000;
      allow update: if isSitterOwner() && validWrite()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.pet == resource.data.pet
        && resource.data.active == true
        && request.resource.data.active == false;
      allow delete: if false;
    }
  }
}